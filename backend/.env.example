# Copy to .env and adjust. All values can also be set as environment variables.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://trackflow:trackflow_dev_pw@localhost:5434/trackflow
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_EMAIL=admin@trackflow.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345
